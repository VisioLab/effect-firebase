---
import { Badge, Icon } from "@astrojs/starlight/components";
import type { Declaration } from "../api/reference.ts";
import ApiDoc from "./ApiDoc.astro";
import StabilityBadge from "./StabilityBadge.astro";

interface Props {
  declaration: Declaration;
}

const { declaration } = Astro.props;
const { doc } = declaration;
---

<div class="api-header">
  <h3 id={declaration.anchor}>
    {declaration.name}{" "}
    <Badge text={declaration.kind} />{" "}
    <StabilityBadge stability={doc.stability} />
  </h3>
  <span class="api-header-meta">
    {doc.since !== undefined && <span>Since v{doc.since}</span>}
    <a
      href={declaration.sourceUrl}
      target="_blank"
      rel="noopener noreferrer"
      title="View source"
      aria-label={`View source for ${declaration.name} (opens in new tab)`}
    >
      <Icon name="github" size="1rem" />
    </a>
  </span>
</div>

<ApiDoc doc={doc} signature={declaration.signature} />

{
  declaration.members.length > 0 && (
    <div class="api-members">
      {declaration.members.map((member) => (
        <>
          <div class="api-header">
            <h4 id={member.anchor}>
              {declaration.name}.{member.name} <StabilityBadge stability={member.doc.stability} />
            </h4>
            {member.doc.since !== undefined && (
              <span class="api-header-meta">Since v{member.doc.since}</span>
            )}
          </div>
          <ApiDoc doc={member.doc} signature={member.signature} />
        </>
      ))}
    </div>
  )
}
