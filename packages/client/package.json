{
  "name": "@visiolab/effect-firebase-client",
  "version": "0.0.0",
  "description": "Firebase client SDK implementation of the @visiolab/effect-firebase services.",
  "keywords": [
    "effect",
    "firebase",
    "typescript"
  ],
  "homepage": "https://github.com/VisioLab/effect-firebase",
  "bugs": {
    "url": "https://github.com/VisioLab/effect-firebase/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VisioLab/effect-firebase.git",
    "directory": "packages/client"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.mjs",
    "dist/**/*.mjs.map",
    "dist/**/*.d.mts",
    "dist/**/*.d.mts.map"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts",
    "./App": "./src/App.ts",
    "./firestore": "./src/firestore/index.ts",
    "./firestore/Firestore": "./src/firestore/Firestore.ts",
    "./firestore/FirestoreEncoder": "./src/firestore/FirestoreEncoder.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./App": "./dist/App.mjs",
      "./firestore": "./dist/firestore/index.mjs",
      "./firestore/Firestore": "./dist/firestore/Firestore.mjs",
      "./firestore/FirestoreEncoder": "./dist/firestore/FirestoreEncoder.mjs",
      "./package.json": "./package.json"
    },
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@visiolab/effect-firebase": "workspace:^",
    "effect": "catalog:",
    "firebase": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@visiolab/effect-firebase": "workspace:^",
    "effect": "catalog:",
    "firebase": "catalog:"
  }
}
