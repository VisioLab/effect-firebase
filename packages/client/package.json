{
  "name": "@visiolab/effect-firebase-client",
  "version": "0.3.0",
  "description": "Firebase client SDK implementation of the @visiolab/effect-firebase services.",
  "keywords": [
    "effect",
    "firebase",
    "typescript"
  ],
  "homepage": "https://github.com/VisioLab/effect-firebase",
  "bugs": {
    "url": "https://github.com/VisioLab/effect-firebase/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VisioLab/effect-firebase.git",
    "directory": "packages/client"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.mjs",
    "dist/**/*.mjs.map",
    "dist/**/*.d.mts",
    "dist/**/*.d.mts.map"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./app": "./src/app/index.ts",
    "./app/App": "./src/app/App.ts",
    "./firestore": "./src/firestore/index.ts",
    "./firestore/ClientDocumentSnapshot": "./src/firestore/ClientDocumentSnapshot.ts",
    "./firestore/ClientFirestore": "./src/firestore/ClientFirestore.ts",
    "./firestore/ClientFirestoreValue": "./src/firestore/ClientFirestoreValue.ts",
    "./firestore/ClientQuerySnapshot": "./src/firestore/ClientQuerySnapshot.ts",
    "./functions": "./src/functions/index.ts",
    "./functions/CallableClient": "./src/functions/CallableClient.ts",
    "./functions/ClientFunctions": "./src/functions/ClientFunctions.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./app": "./dist/app/index.mjs",
      "./app/App": "./dist/app/App.mjs",
      "./firestore": "./dist/firestore/index.mjs",
      "./firestore/ClientDocumentSnapshot": "./dist/firestore/ClientDocumentSnapshot.mjs",
      "./firestore/ClientFirestore": "./dist/firestore/ClientFirestore.mjs",
      "./firestore/ClientFirestoreValue": "./dist/firestore/ClientFirestoreValue.mjs",
      "./firestore/ClientQuerySnapshot": "./dist/firestore/ClientQuerySnapshot.mjs",
      "./functions": "./dist/functions/index.mjs",
      "./functions/CallableClient": "./dist/functions/CallableClient.mjs",
      "./functions/ClientFunctions": "./dist/functions/ClientFunctions.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@visiolab/effect-firebase": "workspace:^",
    "effect": "catalog:",
    "firebase": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@visiolab/effect-firebase": "workspace:^",
    "effect": "catalog:peers",
    "firebase": "catalog:peers"
  }
}
