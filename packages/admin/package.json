{
  "name": "@visiolab/effect-firebase-admin",
  "version": "0.0.0",
  "description": "Firebase Admin SDK implementation of the @visiolab/effect-firebase services.",
  "keywords": [
    "effect",
    "firebase",
    "firebase-admin",
    "typescript"
  ],
  "homepage": "https://github.com/VisioLab/effect-firebase",
  "bugs": {
    "url": "https://github.com/VisioLab/effect-firebase/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VisioLab/effect-firebase.git",
    "directory": "packages/admin"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.mjs",
    "dist/**/*.mjs.map",
    "dist/**/*.d.mts",
    "dist/**/*.d.mts.map"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts",
    "./App": "./src/App.ts",
    "./Auth": "./src/Auth.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./App": "./dist/App.mjs",
      "./Auth": "./dist/Auth.mjs",
      "./package.json": "./package.json"
    },
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "^26.5.1",
    "@visiolab/effect-firebase": "workspace:^",
    "effect": "catalog:",
    "firebase-admin": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@visiolab/effect-firebase": "workspace:^",
    "effect": "catalog:",
    "firebase-admin": "catalog:"
  }
}
