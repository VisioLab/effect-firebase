    ".": "./src/index.ts",
    "./AdminApp": "./src/AdminApp.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./AdminApp": "./dist/AdminApp.mjs",
