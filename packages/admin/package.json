{
  "name": "@visiolab/effect-firebase-admin",
  "version": "0.4.0",
  "description": "Firebase Admin SDK implementation of the @visiolab/effect-firebase services.",
  "keywords": [
    "effect",
    "firebase",
    "firebase-admin",
    "typescript"
  ],
  "homepage": "https://visiolab.github.io/effect-firebase/",
  "bugs": {
    "url": "https://github.com/VisioLab/effect-firebase/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VisioLab/effect-firebase.git",
    "directory": "packages/admin"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.mjs",
    "dist/**/*.mjs.map",
    "dist/**/*.d.mts",
    "dist/**/*.d.mts.map"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./app": "./src/app/index.ts",
    "./app/App": "./src/app/App.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/Auth": "./src/auth/Auth.ts",
    "./firestore": "./src/firestore/index.ts",
    "./firestore/AdminFirestore": "./src/firestore/AdminFirestore.ts",
    "./firestore/AdminFirestoreValue": "./src/firestore/AdminFirestoreValue.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./app": "./dist/app/index.mjs",
      "./app/App": "./dist/app/App.mjs",
      "./auth": "./dist/auth/index.mjs",
      "./auth/Auth": "./dist/auth/Auth.mjs",
      "./firestore": "./dist/firestore/index.mjs",
      "./firestore/AdminFirestore": "./dist/firestore/AdminFirestore.mjs",
      "./firestore/AdminFirestoreValue": "./dist/firestore/AdminFirestoreValue.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@visiolab/effect-firebase": "workspace:^",
    "effect": "catalog:",
    "firebase-admin": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@visiolab/effect-firebase": "workspace:^",
    "effect": "catalog:peers",
    "firebase-admin": "catalog:peers"
  }
}
