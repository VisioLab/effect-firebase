{
  "name": "@effect-firebase/admin",
  "version": "0.0.0",
  "description": "Firebase Admin SDK implementation of the effect-firebase services.",
  "keywords": [
    "effect",
    "firebase",
    "firebase-admin",
    "typescript"
  ],
  "homepage": "https://github.com/Kaeldehta/effect-firebase",
  "bugs": {
    "url": "https://github.com/Kaeldehta/effect-firebase/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaeldehta/effect-firebase.git",
    "directory": "packages/admin"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.mjs",
    "dist/**/*.mjs.map",
    "dist/**/*.d.mts",
    "dist/**/*.d.mts.map"
  ],
  "type": "module",
  "sideEffects": [],
