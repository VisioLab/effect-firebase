{
  "name": "@visiolab/effect-firebase-functions",
  "version": "0.3.1",
  "description": "Cloud Functions for Firebase deployment of the @visiolab/effect-firebase Functions.",
  "keywords": [
    "effect",
    "firebase",
    "firebase-functions",
    "typescript"
  ],
  "homepage": "https://visiolab.github.io/effect-firebase/",
  "bugs": {
    "url": "https://github.com/VisioLab/effect-firebase/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VisioLab/effect-firebase.git",
    "directory": "packages/functions"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.mjs",
    "dist/**/*.mjs.map",
    "dist/**/*.d.mts",
    "dist/**/*.d.mts.map"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts",
    "./Functions": "./src/Functions.ts",
    "./logger": "./src/logger/index.ts",
    "./logger/CloudLogging": "./src/logger/CloudLogging.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./Functions": "./dist/Functions.mjs",
      "./logger": "./dist/logger/index.mjs",
      "./logger/CloudLogging": "./dist/logger/CloudLogging.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "build-fixture": "vp -C tests/fixture pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@visiolab/effect-firebase": "workspace:^",
    "@visiolab/effect-firebase-admin": "workspace:^",
    "effect": "catalog:",
    "firebase": "catalog:",
    "firebase-admin": "catalog:",
    "firebase-functions": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@visiolab/effect-firebase": "workspace:^",
    "@visiolab/effect-firebase-admin": "workspace:^",
    "effect": "catalog:peers",
    "firebase-admin": "catalog:peers",
    "firebase-functions": "catalog:peers"
  }
}
